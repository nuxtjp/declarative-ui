{
  "repository": "nuxtjp/declarative-ui",
  "purpose": "Render declared interfaces and expose typed interaction/owner-input state in Nuxt.",
  "responsibility_boundary": "The consuming application owns authorization, persistence, actual execution and production hosting.",
  "packages": [
    {
      "manifest": "package.json",
      "package": "@nuxtjp/declarative-ui",
      "ecosystem": "npm",
      "description": "Product-independent declarative interaction and exact Nuxt SSR snapshots",
      "interfaces": {
        "exports": {
          ".": {
            "types": "./dist/module.d.ts",
            "import": "./dist/module.js"
          },
          "./interaction": {
            "types": "./dist/runtime/shared/interaction.d.ts",
            "import": "./dist/runtime/shared/interaction.js"
          },
          "./owner-input": "./dist/runtime/app/components/OwnerInput.vue"
        },
        "bin": {},
        "main": "./dist/module.js",
        "types": "./dist/module.d.ts"
      },
      "declared_commands": {
        "build": "node scripts/build.mjs",
        "typecheck": "vue-tsc --noEmit --project tsconfig.json",
        "test": "vitest run && pnpm run test:dependency-security",
        "prepack": "pnpm run test && pnpm run typecheck && pnpm run build",
        "test:dependency-security": "node --test scripts/dependency-security.check.cjs"
      }
    }
  ],
  "schema_definitions": [],
  "test_sources": [
    "src/runtime/shared/drafts.ts",
    "src/runtime/shared/interaction.ts",
    "test/drafts.test.ts",
    "test/input-value.test.ts",
    "test/interaction.test.ts",
    "test/owner-input.test.ts"
  ],
  "example_sources": [
    "playground/public-api/demo.mjs"
  ],
