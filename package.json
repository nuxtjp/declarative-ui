{
  "name": "@nuxtjp/declarative-ui",
  "version": "0.10.0",
  "description": "Product-independent declarative interaction and exact Nuxt SSR snapshots",
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": "^22.0.0 || ^24.0.0",
    "pnpm": ">=10 <11"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "NOTICE",
    "LICENSE-PREVIOUS",
    "README.ja.md",
    "docs/distribution*",
    "playground/public-api",
    "third-party"
  ],
  "main": "./dist/module.js",
  "types": "./dist/module.d.ts",
  "exports": {
    ".": {
      "types": "./dist/module.d.ts",
      "import": "./dist/module.js"
    },
    "./interaction": {
      "types": "./dist/runtime/shared/interaction.d.ts",
      "import": "./dist/runtime/shared/interaction.js"
    },
    "./owner-input": "./dist/runtime/app/components/OwnerInput.vue"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "vue-tsc --noEmit --project tsconfig.json",
    "test": "vitest run && pnpm run test:dependency-security",
    "prepack": "pnpm run test && pnpm run typecheck && pnpm run build",
    "test:dependency-security": "node --test scripts/dependency-security.check.cjs"
  },
  "peerDependencies": {
    "@nuxt/ui": "^4.10.0",
    "nuxt": "^4.5.0",
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@crowsi/interaction-transport": "0.10.1",
    "@zixcel/interaction": "0.10.1",
    "@nuxt/kit": "4.6.1",
    "@nuxt/schema": "4.6.1"
  },
  "devDependencies": {
    "@types/node": "24.12.0",
    "nuxt": "4.6.1",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "vue": "3.5.43",
    "vue-tsc": "3.3.13"
  },
  "pnpm": {
    "overrides": {
      "archiver-utils@5.0.2>glob": "13.0.6",
      "@nuxt/devtools>simple-git": "4.0.2",
      "esbuild@0.27.7": "0.28.2"
    },
    "patchedDependencies": {
      "braces@3.0.3": "patches/braces@3.0.3.patch",
      "node-forge@1.4.0": "patches/node-forge@1.4.0.patch"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nuxtjp/declarative-ui.git"
  }
}
